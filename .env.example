# Backend Configuration
PORT=5000
NODE_ENV=development

# Database
MONGO_URI=mongodb://localhost:27017/codecraftai

# GitHub Integration
GITHUB_TOKEN=your_github_personal_access_token
GITHUB_OAUTH_CLIENT_ID=your_oauth_client_id
GITHUB_OAUTH_CLIENT_SECRET=your_oauth_client_secret

# AI/ML Services
OPENAI_API_KEY=your_openai_api_key
HUGGINGFACE_API_KEY=your_huggingface_api_key

# Speech-to-Text
GOOGLE_CLOUD_SPEECH_API_KEY=your_google_cloud_speech_key

# Frontend Configuration
REACT_APP_API_URL=http://localhost:5000
REACT_APP_GITHUB_OAUTH_CLIENT_ID=your_oauth_client_id
